#!/usr/bin/env bash

set -euo pipefail

omlx_models=$(curl -fsS -H "Authorization: Bearer dummy-key" \
    http://localhost:8000/v1/models)
llama_models=$(curl -fsS -H "Authorization: Bearer dummy-key" \
    http://localhost:8080/v1/models)

jq -nr --argjson omlx "$omlx_models" --argjson llama "$llama_models" \
    '[$omlx.data[]?, $llama.data[]?] | map(.id) | unique[]'
