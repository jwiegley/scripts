#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: ~/download-command <HOST_WITH_PRODUCTS>

Discover the Home Manager and default dev-shell store products on
HOST_WITH_PRODUCTS, copy their transitive closures into the shared file cache,
then print the command that imports them on the destination machine.

Example:
  ~/download-command andoria-08
EOF
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

source_host=$1
ssh_bin=/usr/bin/ssh

if [[ ! -x "$ssh_bin" ]]; then
  ssh_bin=$(command -v ssh)
fi

local_hostname=$(hostname)
runner=("$ssh_bin" "$source_host" bash -se)
if [[ "$source_host" == "$local_hostname" || "$source_host" == "${local_hostname%%.*}" ]]; then
  runner=(bash -se)
fi

echo "Discovering products on $source_host..." >&2
discovery="$(
  "${runner[@]}" <<'REMOTE'
set -euo pipefail

nix_bin=/nix/var/nix/profiles/default/bin/nix
cache_url="file://$HOME/nix-cache"
export PATH="/usr/bin:/bin:/nix/var/nix/profiles/default/bin:$PATH"

if [[ ! -x "$nix_bin" ]]; then
  echo "error: expected Nix at $nix_bin on $(hostname)" >&2
  exit 1
fi

cache_user="${USER:-jwiegley}"
root="/var/tmp/$cache_user/nix-download-command-products"
mkdir -p "$HOME/nix-cache" "$root"
chmod 700 "/var/tmp/$cache_user" "$root" 2>/dev/null || true
system="$("$nix_bin" eval --impure --raw --expr builtins.currentSystem)"
nix_build_options=()
# Keep multiprocessing AF_UNIX sockets below Darwin's path-length limit.
if [[ $(uname -s) == Darwin ]]; then
  nix_build_options=(--option build-dir /tmp)
fi

"$nix_bin" "${nix_build_options[@]}" --extra-experimental-features 'nix-command flakes' \
  build --accept-flake-config \
  --profile "$root/tron-main-devshell" \
  "$HOME/tron/main#devShells.$system.default" >/dev/null

if [[ -d "$HOME/hera/ares/.git" ]] &&
  [[ $(git --git-dir="$HOME/hera/ares/.git" rev-parse --is-bare-repository) == true ]]; then
  ares_flake="git+file://$HOME/hera/ares?ref=main"
elif [[ -d "$HOME/hera/ares" ]]; then
  ares_flake="$HOME/hera/ares"
elif [[ -d "$HOME/ares" ]]; then
  ares_flake="$HOME/ares"
else
  echo "error: cannot find the Ares checkout on $(hostname)" >&2
  exit 1
fi

"$nix_bin" "${nix_build_options[@]}" --extra-experimental-features 'nix-command flakes' \
  build --accept-flake-config \
  --profile "$root/ares-devshell" \
  "$ares_flake#devShells.$system.default" >/dev/null

hm_cli="$("$nix_bin" "${nix_build_options[@]}" --extra-experimental-features 'nix-command flakes' \
  build --accept-flake-config --no-link --print-out-paths \
  'home-manager/master')"

if [[ $(uname -s) == Darwin ]]; then
  hm_activation_ref="$HOME/src/nix#darwinConfigurations.$(hostname -s).config.home-manager.users.$USER.home.activationPackage"
else
  hm_activation_ref="$HOME/.config/home-manager#homeConfigurations.$USER.activationPackage"
fi

hm_activation="$("$nix_bin" "${nix_build_options[@]}" --extra-experimental-features 'nix-command flakes' \
  build --accept-flake-config --no-link --print-out-paths \
  "$hm_activation_ref")"

paths=(
  "$hm_cli"
  "$hm_activation"
  "$(readlink -f "$root/tron-main-devshell")"
  "$(readlink -f "$root/ares-devshell")"
)

for path in "${paths[@]}"; do
  if [[ "$path" != /nix/store/* ]]; then
    echo "error: discovered invalid store path '$path'" >&2
    exit 1
  fi
done

echo "Copying closures into $cache_url on $(hostname)..." >&2
"$nix_bin" "${nix_build_options[@]}" --extra-experimental-features 'nix-command flakes' \
  copy --no-check-sigs --to "$cache_url" "${paths[@]}" >&2

echo "Copying closures into tron.cachix.org..." >&2
cachix push tron "${paths[@]}" >&2

printf 'cache_url=%s\n' "$cache_url"
printf 'hm_cli=%s\n' "$hm_cli"
printf 'hm_activation=%s\n' "$hm_activation"
printf 'tron=%s\n' "${paths[2]}"
printf 'ares=%s\n' "${paths[3]}"
REMOTE
)"

cache_url=
hm_cli=
hm_activation=
tron=
ares=

while IFS='=' read -r key value; do
  case "$key" in
    cache_url) cache_url=$value ;;
    hm_cli) hm_cli=$value ;;
    hm_activation) hm_activation=$value ;;
    tron) tron=$value ;;
    ares) ares=$value ;;
    '') ;;
    *)
      echo "warning: ignoring unexpected discovery line: $key=$value" >&2
      ;;
  esac
done <<<"$discovery"

if [[ "$cache_url" != file:///* ]]; then
  echo "error: discovered invalid cache URL '$cache_url'" >&2
  exit 1
fi

paths=("$hm_cli" "$hm_activation" "$tron" "$ares")
labels=("home-manager CLI" "home-manager activation" "tron dev shell" "ares dev shell")

for i in "${!paths[@]}"; do
  if [[ -z "${paths[$i]}" || "${paths[$i]}" != /nix/store/* ]]; then
    echo "error: failed to discover ${labels[$i]} store path; got '${paths[$i]}'" >&2
    exit 1
  fi
done

echo "Discovered store paths:" >&2
for i in "${!paths[@]}"; do
  printf '  %-24s %s\n' "${labels[$i]}:" "${paths[$i]}" >&2
done

echo "Run this command on the destination machine:" >&2
printf "nix copy --no-check-sigs --from '%s'" "$cache_url"
printf ' %s' "${paths[@]}"
printf '\n'
