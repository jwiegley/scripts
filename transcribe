#!/etc/profiles/per-user/johnw/bin/python3
"""Transcribe audio files using Cohere ASR (MLX), with optional LLM post-processing.

Usage:
    transcribe -o output.txt input1.m4a input2.wav ...
    transcribe input.m4a                          # prints to stdout
    transcribe -l fr -o out.txt in.wav            # French transcription
    transcribe -p 'Clean up and add paragraphs' input.m4a  # managed LiteLLM route
    transcribe -p @prompt.txt -m ManualModel --api-base URL \
        --api-key-file ~/.config/private-key -o out.txt input.m4a
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path

import numpy as np

MODEL_DIR = Path.home() / "src/mlx-speech/models/cohere/cohere_transcribe/mlx-int8"
SAMPLE_RATE = 16000
DEFAULT_API_BASE = "http://localhost:8000/v1"
DEFAULT_API_KEY = "dummy-key"
DEFAULT_LLM_CONFIG = Path.home() / ".config/promptdeploy/default-llm.json"


@dataclass(frozen=True)
class LlmRoute:
    provider: str
    model: str
    base_url: str
    api_key: str


def _llm_config_error(path: Path, reason: str) -> ValueError:
    return ValueError(f"Invalid LLM configuration {path}: {reason}")


def _normalized_base_url(value: str, *, label: str) -> str:
    base_url = value.strip().rstrip("/")
    if not base_url:
        raise ValueError(f"{label} must be a non-empty URL")
    return base_url


def load_managed_llm_route(path: Path) -> LlmRoute:
    """Read and validate a version-1 promptdeploy LiteLLM route."""
    path = Path(path).expanduser()
    try:
        contents = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        raise _llm_config_error(path, "cannot read file") from exc

    try:
        document = json.loads(contents)
    except json.JSONDecodeError as exc:
        raise _llm_config_error(path, "invalid JSON") from exc

    if not isinstance(document, dict):
        raise _llm_config_error(path, "root must be a JSON object")
    if type(document.get("version")) is not int or document["version"] != 1:
        raise _llm_config_error(path, "expected schema version 1")

    values: dict[str, str] = {}
    for field in ("provider", "model", "base_url", "api_key"):
        value = document.get(field)
        if not isinstance(value, str) or not value.strip():
            raise _llm_config_error(path, f"field {field!r} must be a non-empty string")
        values[field] = value

    if values["provider"] != "litellm":
        raise _llm_config_error(path, "provider must be exactly 'litellm'")

    try:
        base_url = _normalized_base_url(
            values["base_url"], label="managed base_url"
        )
    except ValueError as exc:
        raise _llm_config_error(path, "field 'base_url' must be a non-empty URL") from exc

    return LlmRoute(
        provider="litellm",
        model=values["model"].strip(),
        base_url=base_url,
        api_key=values["api_key"].strip(),
    )


def _read_api_key_file(path: Path) -> str:
    path = Path(path).expanduser()
    try:
        api_key = path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError) as exc:
        raise ValueError(f"Invalid API key file {path}: cannot read file") from exc
    if not api_key:
        raise ValueError(f"Invalid API key file {path}: credential is empty")
    return api_key


def resolve_llm_route(
    *,
    model: str | None,
    api_base: str | None,
    api_key_file: Path | None,
    llm_config: Path,
    list_models: bool = False,
) -> LlmRoute:
    """Resolve explicit, managed, and direct-development LLM settings."""
    explicit_model = model.strip() if model is not None else None
    if model is not None and not explicit_model:
        raise ValueError("--model must be non-empty")
    explicit_base = (
        _normalized_base_url(api_base, label="--api-base")
        if api_base is not None
        else None
    )
    explicit_key = (
        _read_api_key_file(api_key_file) if api_key_file is not None else None
    )
    llm_config = Path(llm_config).expanduser()

    if list_models:
        if explicit_base is not None:
            return LlmRoute(
                provider="direct",
                model="",
                base_url=explicit_base,
                api_key=explicit_key or DEFAULT_API_KEY,
            )
        managed = load_managed_llm_route(llm_config)
        return LlmRoute(
            provider="litellm",
            model=managed.model,
            base_url=managed.base_url,
            api_key=explicit_key or managed.api_key,
        )

    if (
        explicit_model is not None
        and explicit_base is not None
        and explicit_key is not None
    ):
        return LlmRoute(
            provider="direct",
            model=explicit_model,
            base_url=explicit_base,
            api_key=explicit_key,
        )

    if llm_config.exists():
        managed = load_managed_llm_route(llm_config)
        return LlmRoute(
            provider="litellm",
            model=explicit_model or managed.model,
            base_url=explicit_base or managed.base_url,
            api_key=explicit_key or managed.api_key,
        )

    if explicit_model is not None:
        return LlmRoute(
            provider="direct",
            model=explicit_model,
            base_url=explicit_base or DEFAULT_API_BASE,
            api_key=explicit_key or DEFAULT_API_KEY,
        )

    return load_managed_llm_route(llm_config)


def load_audio(path: Path) -> np.ndarray:
    """Load audio as float32 mono at 16 kHz, converting via ffmpeg if needed."""
    suffix = path.suffix.lower()
    # soundfile handles wav/flac/ogg natively; everything else goes through ffmpeg
    if suffix in (".wav", ".flac", ".ogg"):
        import soundfile as sf

        audio, sr = sf.read(str(path), dtype="float32", always_2d=False)
        if audio.ndim > 1:
            audio = audio.mean(axis=1)
        if sr != SAMPLE_RATE:
            audio = _resample(audio, sr)
        return audio.astype(np.float32)

    # Use ffmpeg to decode m4a/mp3/aac/opus/etc. to raw PCM
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error",
        "-i", str(path),
        "-ar", str(SAMPLE_RATE), "-ac", "1",
        "-f", "s16le", "-acodec", "pcm_s16le",
        "pipe:1",
    ]
    result = subprocess.run(cmd, capture_output=True)
    if result.returncode != 0:
        print(f"ffmpeg error for {path}: {result.stderr.decode()}", file=sys.stderr)
        sys.exit(1)
    audio = np.frombuffer(result.stdout, dtype=np.int16).astype(np.float32) / 32768.0
    return audio


def _resample(audio: np.ndarray, sr: int) -> np.ndarray:
    """Resample audio to SAMPLE_RATE."""
    try:
        from math import gcd
        from scipy.signal import resample_poly

        g = gcd(SAMPLE_RATE, sr)
        return resample_poly(audio, SAMPLE_RATE // g, sr // g).astype(np.float32)
    except ImportError:
        old_len = len(audio)
        new_len = int(round(old_len * SAMPLE_RATE / sr))
        return np.interp(
            np.linspace(0, old_len - 1, new_len), np.arange(old_len), audio
        ).astype(np.float32)


def llm_process(
    text: str,
    prompt: str,
    route: LlmRoute,
    request_id: str | None = None,
) -> str:
    """Send text through an OpenAI-compatible chat API for post-processing.

    Uses streaming so the proxy never sees a silent connection and the client's
    socket timeout becomes a per-chunk idle detector rather than a wall clock.
    """
    url = f"{route.base_url}/chat/completions"
    # Cleanup tasks produce output of roughly the same size as input
    # (≈4 chars/token), so cap generously to bound runaway generation.
    max_tokens = min(32768, max(2048, len(text) // 2))
    request_body: dict[str, object] = {
        "model": route.model,
        "messages": [
            {"role": "system", "content": prompt},
            {"role": "user", "content": text},
        ],
        "temperature": 0.3,
        "max_tokens": max_tokens,
        "stream": True,
        # Qwen served by omlx thinks by default, which streams reasoning prose
        # into content and burns the token cap; cleanup needs the answer only.
        "chat_template_kwargs": {"enable_thinking": False},
    }
    if request_id and route.provider == "litellm":
        request_body["metadata"] = {"recording_session": request_id}
    payload = json.dumps(request_body).encode()

    req = urllib.request.Request(
        url,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
            "Authorization": f"Bearer {route.api_key}",
        },
        method="POST",
    )
    chunks: list[str] = []
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            for raw in resp:
                line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
                if not line.startswith("data: "):
                    continue
                data = line[len("data: "):]
                if data == "[DONE]":
                    break
                try:
                    obj = json.loads(data)
                except json.JSONDecodeError:
                    continue
                delta = obj.get("choices", [{}])[0].get("delta", {})
                content = delta.get("content")
                if content:
                    chunks.append(content)
    except urllib.error.URLError as e:
        print(f"Error contacting LLM API at {route.base_url}: {e}", file=sys.stderr)
        sys.exit(1)

    return "".join(chunks)


def resolve_prompt(value: str) -> str:
    """If value starts with @, read the prompt from that file path."""
    if value.startswith("@"):
        path = Path(value[1:]).expanduser()
        if not path.exists():
            print(f"Error: prompt file not found: {path}", file=sys.stderr)
            sys.exit(1)
        return path.read_text(encoding="utf-8").strip()
    return value


def main() -> None:
    p = argparse.ArgumentParser(
        description="Transcribe audio files using Cohere ASR (MLX)",
        epilog=(
            "Post-processing: use -p to send the transcript through the managed "
            "promptdeploy LiteLLM route.\n"
            "Prefix with @ to read the prompt from a file: -p @prompt.txt. "
            "A complete explicit model, API base, and private key file overrides "
            "the managed route."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        allow_abbrev=False,
    )
    p.add_argument("inputs", nargs="*", help="Audio files to transcribe")
    p.add_argument("-o", "--output", help="Write result to file (default: stdout)")
    p.add_argument("-l", "--language", default="en", help="ISO 639-1 language code")
    p.add_argument("-p", "--prompt", help="LLM processing prompt (or @file.txt)")
    p.add_argument(
        "-m",
        "--model",
        help="Explicit LLM model override for post-processing",
    )
    p.add_argument(
        "--api-base",
        default=None,
        help="Explicit OpenAI-compatible API base URL override",
    )
    p.add_argument(
        "--api-key-file",
        type=Path,
        help="Private file containing an explicit API credential override",
    )
    p.add_argument(
        "--llm-config",
        type=Path,
        default=DEFAULT_LLM_CONFIG,
        help="Managed promptdeploy route (default: %(default)s)",
    )
    p.add_argument(
        "--check-llm-config",
        action="store_true",
        help="Validate the managed route and exit without loading ASR",
    )
    p.add_argument(
        "--request-id",
        help="Non-secret recording identifier sent as managed LiteLLM metadata",
    )
    p.add_argument("--list-models", action="store_true",
                   help="List models using the managed or explicit API endpoint")
    p.add_argument("--asr-model-dir", default=str(MODEL_DIR), help="MLX ASR model directory")
    p.add_argument("--max-new-tokens", type=int, default=448)
    argv = sys.argv[1:]
    if any(arg == "--api-key" or arg.startswith("--api-key=") for arg in argv):
        p.error("--api-key has been removed; use --api-key-file PATH")
    args = p.parse_args(argv)

    if args.check_llm_config:
        try:
            load_managed_llm_route(args.llm_config)
        except ValueError as exc:
            p.error(str(exc))
        print(f"LLM configuration is valid: {args.llm_config}")
        return

    if args.list_models:
        try:
            route = resolve_llm_route(
                model=args.model,
                api_base=args.api_base,
                api_key_file=args.api_key_file,
                llm_config=args.llm_config,
                list_models=True,
            )
        except ValueError as exc:
            p.error(str(exc))
        try:
            url = f"{route.base_url}/models"
            req = urllib.request.Request(
                url, headers={"Authorization": f"Bearer {route.api_key}"})
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read())
            for m in sorted(data.get("data", []), key=lambda x: x["id"]):
                print(m["id"])
        except urllib.error.URLError as e:
            print(f"Error contacting API at {route.base_url}: {e}", file=sys.stderr)
            sys.exit(1)
        return

    route = None
    if args.prompt:
        try:
            route = resolve_llm_route(
                model=args.model,
                api_base=args.api_base,
                api_key_file=args.api_key_file,
                llm_config=args.llm_config,
            )
        except ValueError as exc:
            p.error(str(exc))

    if not args.inputs:
        p.error("at least one audio file is required")

    model_dir = Path(args.asr_model_dir)
    if not model_dir.exists():
        print(f"Error: ASR model not found at {model_dir}", file=sys.stderr)
        sys.exit(1)

    sys.path.insert(0, str(Path.home() / "src/mlx-speech/src"))
    from mlx_speech.generation.cohere_asr import CohereAsrModel

    print("Loading ASR model …", file=sys.stderr)
    asr = CohereAsrModel.from_dir(model_dir)

    segments = []
    for filepath in args.inputs:
        path = Path(filepath)
        if not path.exists():
            print(f"Error: {path} not found", file=sys.stderr)
            sys.exit(1)

        print(f"Loading {path.name} …", file=sys.stderr)
        audio = load_audio(path)
        duration_s = len(audio) / SAMPLE_RATE
        print(f"  {duration_s:.1f}s", file=sys.stderr)

        print(f"Transcribing {path.name} …", file=sys.stderr)
        result = asr.transcribe(
            audio,
            language=args.language,
            max_new_tokens=args.max_new_tokens,
        )
        segments.append(result.text)

    text = "\n\n".join(segments) + "\n"

    if args.prompt:
        assert route is not None
        prompt = resolve_prompt(args.prompt)
        print(f"Processing with {route.model} …", file=sys.stderr)
        text = llm_process(text, prompt, route, request_id=args.request_id) + "\n"

    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
        print(f"Written to {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
