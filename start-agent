#!/usr/bin/env bash
set -euo pipefail

CODEX_MODEL=${CODEX_MODEL:-gpt-5.6-sol}
CLAUDE_MODEL=${CLAUDE_MODEL:-"claude-opus-5[1m]"}
PI_PROVIDER=${PI_PROVIDER:-openai-codex}
PI_MODEL=${PI_MODEL:-gpt-5.6-sol}

usage() {
    printf 'Usage: %s {pi|codex|claude} WORKDIR [TITLE] [GROUP]\n' "${0##*/}" >&2
    exit 2
}

if [[ $# -lt 2 || $# -gt 4 ]]; then
    usage
fi

if ! command -v jq >/dev/null 2>&1; then
    printf '%s: jq is required to parse agent-deck --json output\n' "${0##*/}" >&2
    exit 1
fi

TOOL=${1:-pi}
WORKDIR=${2/#\~/$HOME}

if [[ ! -d "$WORKDIR" ]]; then
    printf '%s: workdir does not exist: %s\n' "${0##*/}" "$WORKDIR" >&2
    exit 1
fi

WORKDIR=$(cd "$WORKDIR" && pwd -P)
TITLE=${3:-$(basename "$WORKDIR")}
GROUP=${4:-"My Sessions"}
SESSION_TOOL_OVERRIDE=

case "$TOOL" in
    pi)
        printf -v pi_command 'pi --provider %q --model %q' "$PI_PROVIDER" "$PI_MODEL"
        add_json=$(agent-deck add                                               \
                              --json                                            \
                              -c "$pi_command"                                  \
                              -t "$TITLE"                                       \
                              -g "$GROUP"                                       \
                              "$WORKDIR")
        SESSION_TOOL_OVERRIDE=pi
        ;;

    codex)
        add_json=$(agent-deck add                                               \
                              --json                                            \
                              -c codex                                          \
                              --yolo                                            \
                              --model "$CODEX_MODEL"                            \
                              -t "$TITLE"                                       \
                              -g "$GROUP"                                       \
                              "$WORKDIR")
        ;;

    claude)
        add_json=$(agent-deck add                                               \
                              --json                                            \
                              -c claude                                         \
                              --extra-arg=--effort                              \
                              --extra-arg=max                                   \
                              --extra-arg=--dangerously-skip-permissions        \
                              --model "$CLAUDE_MODEL"                           \
                              -t "$TITLE"                                       \
                              -g "$GROUP"                                       \
                              "$WORKDIR")
        ;;

    *)
        usage
        ;;
esac

session_id=$(jq -er '.id' <<<"$add_json")
if [[ -n $SESSION_TOOL_OVERRIDE ]]; then
    agent-deck session set "$session_id" tool "$SESSION_TOOL_OVERRIDE" --quiet
fi
agent-deck session start "$session_id"
