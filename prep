#!/usr/bin/env bash

set -eo pipefail

function prep() {
    set -eo pipefail

    if [[ $1 == vulcan ]]; then
        if [[ $UPGRADE == true ]]; then
            ssh $1 "(cd /etc/nixos; nix flake update --commit-lock-file && sudo nixos-rebuild switch --flake '.#vulcan')"
        else
            ssh $1 "(cd /etc/nixos; sudo nixos-rebuild switch --flake '.#vulcan')"
        fi
    else
        if [[ $UPGRADE == true ]]; then
            ssh $1 '(cd .config/home-manager; nix flake update --commit-lock-file && nix run home-manager/master -- switch -b backup)'
        else
            ssh $1 '(cd .config/home-manager; nix run home-manager/master -- switch -b backup)'
        fi
        ssh $1 '([[ -d tron/main ]] && (cd tron/main; git submodule update --init --recursive; nix develop --command echo hello))'
        ssh $1 '([[ -d ares ]] && (cd ares; git submodule update --init --recursive; nix develop --command echo hello))'
    fi

    echo
    echo "COMPLETED at $(date)"
}

export UPGRADE=false
if [[ "$1" == --upgrade ]]; then
    export UPGRADE=true
fi

echo "Building vulcan, progress: ~/Library/Logs/prep-vulcan.log"
(prep vulcan > ~/Library/Logs/prep-vulcan.log 2>&1 || exit 0) &

echo "Building andoria-08, progress: ~/Library/Logs/prep-andoria-08.log"
if prep andoria-08 2>&1 | tee ~/Library/Logs/prep-andoria-08.log
then
    export UPGRADE=false

    echo "Building andoria-t2, progress: ~/Library/Logs/prep-andoria-t2.log"
    prep andoria-t2 > ~/Library/Logs/prep-andoria-t2.log 2>&1 &
    echo "Building delphi-3bd4, progress: ~/Library/Logs/prep-delphi-3bd4.log"
    prep delphi-3bd4 > ~/Library/Logs/prep-delphi-3bd4.log 2>&1 &
    echo "Building gpu-server, progress: ~/Library/Logs/prep-gpu-server.log"
    prep gpu-server > ~/Library/Logs/prep-gpu-server.log 2>&1 &

    multitail -i ~/Library/Logs/prep-vulcan.log         \
              -i ~/Library/Logs/prep-andoria-t2.log     \
              -i ~/Library/Logs/prep-delphi-3bd4.log    \
              -i ~/Library/Logs/prep-gpu-server.log
else
    multitail -i ~/Library/Logs/prep-vulcan.log
fi

wait
