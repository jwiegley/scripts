#!/usr/bin/env bash

# flatten-recordings — Move .m4a files from subdirectories of ~/Recordings
# up to ~/Recordings, transcribe each one, then archive the original
# audio to ~/Audio/Recordings.
#
# Structured, timestamped log: ~/Library/Logs/flatten-recordings.log

set -uo pipefail

recordings_dir="$HOME/Recordings"
archive_dir="$HOME/Audio/Recordings"
org_queue_dir="${RECORDING_TRANSCRIPT_QUEUE:-$HOME/.local/share/recording-transcripts}"
org_receipt_dir="$org_queue_dir/.imported"
prompt_file="$HOME/doc/post-process.md"
llm_config="$HOME/.config/promptdeploy/default-llm.json"

# Give up transcribing a single file after this many failed attempts, so a
# permanently-bad recording isn't re-transcribed (an expensive call) on every
# run forever.
max_attempts=5

log_dir="$HOME/Library/Logs"
log_file="$log_dir/flatten-recordings.log"
lock_file="$log_dir/.flatten-recordings.lock"
run_dir="$log_dir/.flatten-recordings.run"
# Per-file transcription failure counters. Kept under ~/Library/Logs (local)
# rather than in ~/Recordings so they don't sync to iCloud.
state_dir="$log_dir/flatten-recordings.state"
session_id="$$.$(date +%s)"
start_epoch=$(date +%s)

mkdir -p "$log_dir"

exit_code=0
subdir_moved=0
move_failed=0
ds_removed=0
empty_dirs_removed=0
transcribed=0
transcribe_failed=0
transcribe_gave_up=0
archive_failed=0

log() {
    printf '%s session=%s %s\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$session_id" "$*" >>"$log_file"
}

# Transaction manifest fields loaded by load_transaction.
TRANSACTION_STATE=''
TRANSACTION_BASE=''
TRANSACTION_BASE_HASH=''
TRANSACTION_SOURCE_HASH=''
TRANSACTION_SOURCE_IDENTITY=''
TRANSACTION_CLAIM_DIR_NAME=''
TRANSACTION_TRANSCRIPT_HASH=''

is_sha256() {
    local value=$1

    [ "${#value}" -eq 64 ] || return 1
    case "$value" in
        *[!0-9a-f]*) return 1 ;;
    esac
}

file_hash() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

text_hash() {
    printf '%s' "$1" | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

file_identity() {
    /usr/bin/stat -f '%d:%i:%B:%z' "$1"
}

load_transaction() {
    local transaction=$1
    local version state base_hash source_hash source_identity claim_dir_name
    local transcript_hash extra name stem base actual_base_hash
    local dev inode birth size identity_extra

    TRANSACTION_STATE=''
    TRANSACTION_BASE=''
    TRANSACTION_BASE_HASH=''
    TRANSACTION_SOURCE_HASH=''
    TRANSACTION_SOURCE_IDENTITY=''
    TRANSACTION_CLAIM_DIR_NAME=''
    TRANSACTION_TRANSCRIPT_HASH=''

    [ -d "$transaction" ] && [ ! -L "$transaction" ] \
        && [ -f "$transaction/manifest" ] \
        && [ ! -L "$transaction/manifest" ] || return 1
    name=${transaction##*/}
    case "$name" in
        .*.m4a.flatten-txn.*) ;;
        *) return 1 ;;
    esac
    stem=${name%.*}
    base=${stem#.}
    base=${base%.flatten-txn}
    case "$base" in
        *.m4a) ;;
        *) return 1 ;;
    esac

    IFS=' ' read -r version state base_hash source_hash source_identity \
        claim_dir_name transcript_hash extra \
        <"$transaction/manifest" || return 1
    [ "$version" = v4 ] && [ -z "$extra" ] || return 1
    case "$state" in
        preparing)
            [ "$transcript_hash" = - ] || return 1
            ;;
        claiming|ready)
            is_sha256 "$transcript_hash" || return 1
            ;;
        *) return 1 ;;
    esac
    is_sha256 "$base_hash" && is_sha256 "$source_hash" || return 1
    actual_base_hash=$(text_hash "$base") || return 1
    [ "$actual_base_hash" = "$base_hash" ] || return 1
    case "$claim_dir_name" in
        .flatten-recordings-claim-*) ;;
        *) return 1 ;;
    esac
    case "$claim_dir_name" in
        */*|*..*) return 1 ;;
    esac
    IFS=: read -r dev inode birth size identity_extra <<<"$source_identity"
    [ -z "$identity_extra" ] || return 1
    for value in "$dev" "$inode" "$birth" "$size"; do
        case "$value" in
            ''|*[!0-9]*) return 1 ;;
        esac
    done

    TRANSACTION_STATE=$state
    TRANSACTION_BASE=$base
    TRANSACTION_BASE_HASH=$base_hash
    TRANSACTION_SOURCE_HASH=$source_hash
    TRANSACTION_SOURCE_IDENTITY=$source_identity
    TRANSACTION_CLAIM_DIR_NAME=$claim_dir_name
    TRANSACTION_TRANSCRIPT_HASH=$transcript_hash
}

source_matches_transaction() {
    local source=$1
    local current_identity current_hash

    [ -f "$source" ] && [ ! -L "$source" ] || return 1
    current_identity=$(file_identity "$source") || return 1
    [ "$current_identity" = "$TRANSACTION_SOURCE_IDENTITY" ] || return 1
    current_hash=$(file_hash "$source") || return 1
    [ "$current_hash" = "$TRANSACTION_SOURCE_HASH" ]
}

# Move an unmanifested claim into a fresh private subdirectory of the inbox.
# The next sweep's normal subdirectory lift gives it a unique top-level name.
# Both renames stay on the inbox filesystem, and the mkdir-reserved namespace
# prevents overwriting any shared path.
requeue_unowned_claim() {
    local claim=$1
    local source=$2
    local source_base stem recovery_dir token recovery_base recovery_path

    [ -f "$claim" ] && [ ! -L "$claim" ] || return 1
    source_base=${source##*/}
    stem=${source_base%.m4a}
    recovery_dir=$(
        /usr/bin/mktemp -d "$recordings_dir/.flatten-recordings-recovery.XXXXXX"
    ) || return 1
    token=${recovery_dir##*.}
    recovery_base="$stem-recovered-$token.m4a"
    recovery_path="$recovery_dir/$recovery_base"

    if /bin/mv "$claim" "$recovery_path" >>"$log_file" 2>&1; then
        log "requeued replacement file=$source recovery=$recovery_path"
        return 0
    fi
    # A killed mv can complete rename(2) without returning success. The
    # reserved directory had no prior entries, so this exact regular path is
    # sufficient recovery evidence.
    if [ ! -e "$claim" ] && [ ! -L "$claim" ] \
            && [ -f "$recovery_path" ] && [ ! -L "$recovery_path" ]; then
        log "recovered requeued replacement file=$source recovery=$recovery_path"
        return 0
    fi
    rmdir "$recovery_dir" 2>/dev/null || true
    return 1
}

# Atomically move the public source pathname into a newly reserved private
# directory before archive publication. Return 0 when the manifested source is
# claimed, 2 when a replacement was preserved or requeued, 3 when deletion won
# the race (an explicit cancellation), and 1 for an unresolved collision.
claim_transaction_source() {
    local source=$1
    local defer_requeue=${2:-0}
    local claim_dir="$recordings_dir/$TRANSACTION_CLAIM_DIR_NAME"
    local claim="$claim_dir/source"
    local unknown_entry=''

    if [ -e "$claim_dir" ] || [ -L "$claim_dir" ]; then
        [ -d "$claim_dir" ] && [ ! -L "$claim_dir" ] || return 1
        unknown_entry=$(
            /usr/bin/find "$claim_dir" -mindepth 1 -maxdepth 1 \
                ! -name source -print -quit
        ) || return 1
        [ -z "$unknown_entry" ] || return 1
    fi
    if [ -e "$claim" ] || [ -L "$claim" ]; then
        if source_matches_transaction "$claim"; then
            return 0
        fi
        # This is an unmanifested replacement that won the hash-to-rename
        # race. Requeue it under a unique basename rather than deleting it or
        # leaving it permanently hidden behind this completed transaction.
        if [ "$defer_requeue" -ne 0 ]; then
            return 2
        fi
        if requeue_unowned_claim "$claim" "$source"; then
            rmdir "$claim_dir" || return 1
            return 2
        fi
        return 1
    fi
    if [ -d "$claim_dir" ] && [ ! -L "$claim_dir" ]; then
        # Recover a crash after reserving the directory, or after removing its
        # claimed source. Removing and recreating it below proves that the
        # rename target is empty and privately reserved by this invocation.
        rmdir "$claim_dir" || return 1
    fi

    if [ ! -e "$source" ] && [ ! -L "$source" ]; then
        return 3
    fi
    if ! source_matches_transaction "$source"; then
        return 2
    fi

    # Darwin's `mv -n` is an access-then-rename sequence rather than an atomic
    # no-replace operation. An atomic mkdir instead reserves an empty private
    # namespace, so the same-filesystem rename below cannot clobber a shared
    # path. Verification detects replacement of SOURCE in the preceding hash
    # window; such a file is requeued without overwriting a newer arrival.
    /bin/mkdir -m 700 "$claim_dir" >>"$log_file" 2>&1 || return 1
    if ! /bin/mv "$source" "$claim" >>"$log_file" 2>&1; then
        # A killed mv can complete rename(2) without returning success to the
        # shell. Never discard the transaction while a claim may therefore
        # contain the only copy of an unmanifested replacement.
        if [ -e "$claim" ] || [ -L "$claim" ]; then
            return 1
        fi
        rmdir "$claim_dir" || return 1
        if [ ! -e "$source" ] && [ ! -L "$source" ]; then
            return 3
        fi
        return 1
    fi
    if source_matches_transaction "$claim"; then
        return 0
    fi
    # A replacement won the hash-to-rename race. Requeue it through a private
    # directory so the next sweep lifts and processes it under a unique name.
    if [ "$defer_requeue" -ne 0 ]; then
        return 2
    fi
    if requeue_unowned_claim "$claim" "$source"; then
        rmdir "$claim_dir" || return 1
        return 2
    fi
    return 1
}

# Finish source ownership only after both archive members are verified. An
# absent source without a claim is a recovered completion from an earlier run;
# a freshly prepared transaction calls claim_transaction_source first and
# therefore cannot mistake deletion for success.
complete_transaction_source() {
    local source=$1
    local claim_dir="$recordings_dir/$TRANSACTION_CLAIM_DIR_NAME"
    local claim="$claim_dir/source"
    local claim_rc=0

    claim_transaction_source "$source" || claim_rc=$?
    case "$claim_rc" in
        0)
            source_matches_transaction "$claim" || return 1
            rm -f -- "$claim" && rmdir "$claim_dir" || return 1
            if [ -e "$source" ] || [ -L "$source" ]; then
                return 2
            fi
            return 0
            ;;
        2) return 2 ;;
        3) return 0 ;;
        *) return 1 ;;
    esac
}

# A final archive path belongs to a live transaction when it is a regular hard
# link to that transaction's private stage file.
owned_stage_link() {
    local stage=$1
    local final=$2

    [ -f "$stage" ] && [ ! -L "$stage" ] \
        && [ -f "$final" ] && [ ! -L "$final" ] \
        && [ "$stage" -ef "$final" ]
}

# A ready manifest also makes completed publication recoverable after either
# stage hard link was already removed during an interrupted cleanup.
final_matches_hash() {
    local final=$1
    local expected_hash=$2
    local actual_hash

    [ -f "$final" ] && [ ! -L "$final" ] || return 1
    actual_hash=$(file_hash "$final") || return 1
    [ "$actual_hash" = "$expected_hash" ]
}

# Hard-link publication is atomic and fails rather than replacing an existing
# path. A link already owned by this stage is a recovered successful publish.
publish_stage() {
    local stage=$1
    local final=$2

    if owned_stage_link "$stage" "$final"; then
        return 0
    fi
    if [ -e "$final" ] || [ -L "$final" ]; then
        return 1
    fi
    /bin/ln "$stage" "$final" >>"$log_file" 2>&1 \
        && owned_stage_link "$stage" "$final"
}

ensure_transaction_final() {
    local stage=$1
    local final=$2
    local expected_hash=$3

    if final_matches_hash "$final" "$expected_hash"; then
        return 0
    fi
    if [ -e "$final" ] || [ -L "$final" ]; then
        return 1
    fi
    final_matches_hash "$stage" "$expected_hash" \
        && publish_stage "$stage" "$final" \
        && final_matches_hash "$final" "$expected_hash"
}

final_available() {
    local final=$1
    local expected_hash=$2

    if [ ! -e "$final" ] && [ ! -L "$final" ]; then
        return 0
    fi
    final_matches_hash "$final" "$expected_hash"
}

receipt_matches_hash() {
    local receipt=$1
    local expected_hash=$2
    local actual_hash

    [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
    IFS= read -r actual_hash <"$receipt" || return 1
    [ "$actual_hash" = "$expected_hash" ]
}

ensure_org_queue_final() {
    local stage=$1
    local archived=$2
    local queued=$3
    local receipt=$4
    local expected_hash=$5
    local source=$stage

    if receipt_matches_hash "$receipt" "$expected_hash"; then
        return 0
    fi
    if ! final_matches_hash "$source" "$expected_hash"; then
        source=$archived
    fi
    final_available "$queued" "$expected_hash" \
        && ensure_transaction_final "$source" "$queued" "$expected_hash"
}

remove_transaction() {
    local transaction=$1

    [ -d "$transaction" ] && [ ! -L "$transaction" ] || return 1
    rm -f -- "$transaction/audio" "$transaction/transcript" \
        "$transaction/manifest.next" || return 1
    rm -f -- "$transaction/manifest" || return 1
    rmdir "$transaction"
}

create_transaction() {
    local source=$1
    local base=$2
    local base_hash source_hash source_identity transaction token claim_dir_name

    base_hash=$(text_hash "$base") || return 1
    source_hash=$(file_hash "$source") || return 1
    source_identity=$(file_identity "$source") || return 1
    transaction=$(
        /usr/bin/mktemp -d "$archive_dir/.$base.flatten-txn.XXXXXX"
    ) || return 1
    token=${transaction##*.}
    claim_dir_name=".flatten-recordings-claim-$token"
    if ! chmod 700 "$transaction" \
            || ! printf 'v4 preparing %s %s %s %s -\n' \
                "$base_hash" "$source_hash" "$source_identity" \
                "$claim_dir_name" \
                >"$transaction/manifest" \
            || ! chmod 600 "$transaction/manifest"; then
        rm -f -- "$transaction/manifest"
        rmdir "$transaction" 2>/dev/null || true
        return 1
    fi
    printf '%s\n' "$transaction"
}

mark_transaction_claiming() {
    local transaction=$1
    local transcript_hash audio_hash

    load_transaction "$transaction" || return 1
    [ "$TRANSACTION_STATE" = preparing ] || return 1
    audio_hash=$(file_hash "$transaction/audio") || return 1
    [ "$audio_hash" = "$TRANSACTION_SOURCE_HASH" ] || return 1
    transcript_hash=$(file_hash "$transaction/transcript") || return 1
    printf 'v4 claiming %s %s %s %s %s\n' \
        "$TRANSACTION_BASE_HASH" "$TRANSACTION_SOURCE_HASH" \
        "$TRANSACTION_SOURCE_IDENTITY" "$TRANSACTION_CLAIM_DIR_NAME" \
        "$transcript_hash" \
        >"$transaction/manifest.next" || return 1
    chmod 600 "$transaction/manifest.next" || return 1
    mv "$transaction/manifest.next" "$transaction/manifest" || return 1
    load_transaction "$transaction" \
        && [ "$TRANSACTION_STATE" = claiming ]
}

mark_transaction_ready() {
    local transaction=$1
    local audio_hash transcript_hash

    load_transaction "$transaction" || return 1
    [ "$TRANSACTION_STATE" = claiming ] || return 1
    audio_hash=$(file_hash "$transaction/audio") || return 1
    [ "$audio_hash" = "$TRANSACTION_SOURCE_HASH" ] || return 1
    transcript_hash=$(file_hash "$transaction/transcript") || return 1
    [ "$transcript_hash" = "$TRANSACTION_TRANSCRIPT_HASH" ] || return 1
    printf 'v4 ready %s %s %s %s %s\n' \
        "$TRANSACTION_BASE_HASH" "$TRANSACTION_SOURCE_HASH" \
        "$TRANSACTION_SOURCE_IDENTITY" "$TRANSACTION_CLAIM_DIR_NAME" \
        "$TRANSACTION_TRANSCRIPT_HASH" \
        >"$transaction/manifest.next" || return 1
    chmod 600 "$transaction/manifest.next" || return 1
    mv "$transaction/manifest.next" "$transaction/manifest" || return 1
    load_transaction "$transaction" \
        && [ "$TRANSACTION_STATE" = ready ]
}

# Hold a kernel-managed, non-blocking lock on file descriptor 9 for the whole
# process. The kernel releases it after crashes and signals, so there is no PID
# file to reclaim and no publication window in which two runs can become owner.
if ! { exec 9>"$lock_file"; }; then
    log "ERROR setup reason=lock_open_failed path=$lock_file"
    exit 1
fi
lock_rc=0
/usr/bin/lockf -s -t 0 9 || lock_rc=$?
if [ "$lock_rc" -ne 0 ]; then
    if [ "$lock_rc" -eq 75 ]; then
        log "skip reason=already_running"
        exit 0
    fi
    log "ERROR setup reason=lock_acquire_failed rc=$lock_rc path=$lock_file"
    exit 1
fi

on_exit() {
    local rc=$?
    trap - EXIT INT TERM HUP
    if [ "$rc" -ne 0 ] && [ "$exit_code" -eq 0 ]; then
        exit_code="$rc"
    fi
    if [ -n "$run_dir" ]; then
        rm -rf "$run_dir"
    fi
    local duration=$(( $(date +%s) - start_epoch ))
    local result="ok"
    [ "$exit_code" -ne 0 ] && result="error"
    log "result=$result exit=$exit_code duration_s=$duration" \
        "subdir_moved=$subdir_moved move_failed=$move_failed" \
        "ds_removed=$ds_removed empty_dirs_removed=$empty_dirs_removed" \
        "transcribed=$transcribed transcribe_failed=$transcribe_failed" \
        "transcribe_gave_up=$transcribe_gave_up archive_failed=$archive_failed"
    exit "$exit_code"
}
trap on_exit EXIT INT TERM HUP

umask 077
if [ -e "$run_dir" ] || [ -L "$run_dir" ]; then
    log "reclaiming stale_run path=$run_dir"
    if ! rm -rf -- "$run_dir"; then
        log "ERROR setup reason=stale_run_cleanup_failed path=$run_dir"
        exit_code=1
        exit 1
    fi
fi
if ! mkdir -m 700 "$run_dir"; then
    log "ERROR setup reason=run_directory_failed path=$log_dir"
    exit_code=1
    exit 1
fi
if ! chmod 700 "$run_dir" >>"$log_file" 2>&1; then
    log "ERROR setup reason=run_permissions_failed path=$run_dir"
    exit_code=1
    exit 1
fi

log "start pid=$$ host=$(hostname -s 2>/dev/null || echo unknown) user=$(id -un)"
log "config recordings_dir=$recordings_dir archive_dir=$archive_dir" \
    "org_queue_dir=$org_queue_dir prompt=$prompt_file llm_config=$llm_config"

if ! command -v transcribe >/dev/null 2>&1; then
    log "ERROR setup reason=transcribe_not_on_PATH PATH=$PATH"
    exit_code=1
    exit 1
fi

if [ ! -f "$prompt_file" ]; then
    log "WARN setup reason=prompt_missing path=$prompt_file"
fi

if [ ! -d "$recordings_dir" ]; then
    log "skip reason=recordings_dir_missing path=$recordings_dir"
    exit 0
fi
if ! mkdir -p "$archive_dir"; then
    log "ERROR setup reason=archive_directory_failed path=$archive_dir"
    exit_code=1
    exit 1
fi
if ! mkdir -p "$org_queue_dir" "$org_receipt_dir" \
        || ! chmod 700 "$org_queue_dir" "$org_receipt_dir"; then
    log "ERROR setup reason=org_queue_directory_failed path=$org_queue_dir"
    exit_code=1
    exit 1
fi

# Freeze one private route snapshot for this entire run. Validation and every
# transcription use these exact bytes, so a concurrent promptdeploy update
# cannot change the route after retry accounting has begun.
route_snapshot="$run_dir/default-llm.json"
if ! cp "$llm_config" "$route_snapshot" >>"$log_file" 2>&1; then
    log "ERROR llm_config snapshot_failed path=$llm_config"
    exit_code=1
    exit 1
fi
if ! chmod 600 "$route_snapshot" >>"$log_file" 2>&1; then
    log "ERROR llm_config snapshot_permissions_failed path=$llm_config"
    exit_code=1
    exit 1
fi
if ! transcribe --llm-config "$route_snapshot" --check-llm-config \
        >>"$log_file" 2>&1; then
    log "ERROR llm_config invalid path=$llm_config"
    exit_code=1
    exit 1
fi
if ! route_fingerprint=$(
    /usr/bin/shasum -a 256 "$route_snapshot" | /usr/bin/awk '{print $1}'
); then
    log "ERROR llm_config fingerprint_failed path=$llm_config"
    exit_code=1
    exit 1
fi
if [ "${#route_fingerprint}" -ne 64 ]; then
    log "ERROR llm_config fingerprint_invalid path=$llm_config"
    exit_code=1
    exit 1
fi
case "$route_fingerprint" in
    *[!0-9a-f]*)
        log "ERROR llm_config fingerprint_invalid path=$llm_config"
        exit_code=1
        exit 1
        ;;
esac
log "llm_config ok path=$llm_config route_sha256=$route_fingerprint"

# Step 1: lift any .m4a files in subdirectories up to ~/Recordings.
while IFS= read -r -d '' file; do
    dest="$recordings_dir/$(basename "$file")"
    if [ -e "$dest" ]; then
        log "ERROR move_subdir reason=target_exists file=$file dest=$dest"
        move_failed=$((move_failed + 1))
        exit_code=1
    elif mv "$file" "$dest" >>"$log_file" 2>&1; then
        log "moved subdir->top: $file"
        subdir_moved=$((subdir_moved + 1))
    else
        rc=$?
        log "ERROR move_subdir rc=$rc file=$file"
        move_failed=$((move_failed + 1))
        exit_code=1
    fi
done < <(find -L "$recordings_dir"/ -mindepth 2 -type f -name '*.m4a' -print0 2>/dev/null)

# Step 2: macOS-leftover .DS_Store cleanup inside subdirectories.
while IFS= read -r -d '' file; do
    if rm -f "$file"; then
        log "removed ds_store: $file"
        ds_removed=$((ds_removed + 1))
    fi
done < <(find -L "$recordings_dir"/ -mindepth 2 -name '.DS_Store' -print0 2>/dev/null)

# Step 3: remove any subdirectories that are now empty.
while IFS= read -r -d '' dir; do
    if rmdir "$dir" 2>/dev/null; then
        log "removed empty_dir: $dir"
        empty_dirs_removed=$((empty_dirs_removed + 1))
    fi
done < <(find -L "$recordings_dir"/ -mindepth 1 -depth -type d -print0 2>/dev/null)

# Step 4: transcribe every top-level .m4a file, then archive the audio and text.
mkdir -p "$state_dir"

shopt -s nullglob
files=("$recordings_dir"/*.m4a)
transaction_paths=("$archive_dir"/.*.m4a.flatten-txn.*)
shopt -u nullglob

append_work_base() {
    local value=$1
    local existing

    for existing in "${work_bases[@]}"; do
        [ "$existing" = "$value" ] && return 0
    done
    work_bases+=("$value")
}

# Discover every owned transaction before mutating any of them. The manifest
# binds its basename hash to the directory name, so renamed or malformed paths
# remain untouched. A duplicate basename is detected later from this immutable
# snapshot and blocks all work for that basename.
work_bases=()
valid_transaction_paths=()
valid_transaction_bases=()
for file in "${files[@]}"; do
    append_work_base "$(basename "$file")"
done
for transaction_path in "${transaction_paths[@]}"; do
    if load_transaction "$transaction_path"; then
        valid_transaction_paths+=("$transaction_path")
        valid_transaction_bases+=("$TRANSACTION_BASE")
        append_work_base "$TRANSACTION_BASE"
    else
        log "WARN archive reason=unowned_transaction_path path=$transaction_path"
    fi
done

if [ "${#work_bases[@]}" -eq 0 ]; then
    log "transcribe found=0"
else
    log "transcribe found=${#work_bases[@]}"
    for base in "${work_bases[@]}"; do
        file="$recordings_dir/$base"
        fail_file="$state_dir/$base.fail"
        request_id="$session_id:$base"
        dest="$archive_dir/$base"
        transcript_dest="$archive_dir/$base.txt"
        org_transcript_dest="$org_queue_dir/$base.txt"
        org_receipt="$org_receipt_dir/$base.txt.sha256"
        transcript_source="$run_dir/$base.txt"
        transaction=''
        owned_transactions=()

        for index in "${!valid_transaction_paths[@]}"; do
            if [ "${valid_transaction_bases[$index]}" = "$base" ]; then
                owned_transactions+=("${valid_transaction_paths[$index]}")
            fi
        done
        if [ "${#owned_transactions[@]}" -gt 1 ]; then
            log "ERROR archive reason=multiple_owned_transactions file=$file"
            archive_failed=$((archive_failed + 1))
            exit_code=1
            continue
        fi
        if [ "${#owned_transactions[@]}" -eq 1 ]; then
            transaction=${owned_transactions[0]}
        fi

        if [ -n "$transaction" ]; then
            if ! load_transaction "$transaction" \
                    || [ "$TRANSACTION_BASE" != "$base" ]; then
                log "ERROR archive reason=transaction_changed path=$transaction"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
            audio_stage="$transaction/audio"
            transcript_stage="$transaction/transcript"

            if [ "$TRANSACTION_STATE" = claiming ]; then
                if ! final_matches_hash "$audio_stage" \
                        "$TRANSACTION_SOURCE_HASH" \
                        || ! final_matches_hash "$transcript_stage" \
                            "$TRANSACTION_TRANSCRIPT_HASH"; then
                    log "ERROR archive reason=claiming_stage_changed" \
                        "path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
                source_claim_rc=0
                claim_transaction_source "$file" 1 || source_claim_rc=$?
                case "$source_claim_rc" in
                    0|2) ;;
                    3)
                        if remove_transaction "$transaction"; then
                            rm -f -- "$fail_file"
                            log "canceled deleted recording file=$file"
                        else
                            log "ERROR archive reason=transaction_cleanup_failed" \
                                "path=$transaction"
                            archive_failed=$((archive_failed + 1))
                            exit_code=1
                        fi
                        continue
                        ;;
                    *)
                        log "ERROR archive reason=source_claim_unresolved" \
                            "file=$file path=$transaction"
                        archive_failed=$((archive_failed + 1))
                        exit_code=1
                        continue
                        ;;
                esac
                if ! mark_transaction_ready "$transaction"; then
                    log "ERROR archive reason=ready_transition_failed" \
                        "path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
                load_transaction "$transaction" || {
                    log "ERROR archive reason=transaction_changed" \
                        "path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                }
            fi

            if [ "$TRANSACTION_STATE" = ready ]; then
                ready_claim_rc=0
                claim_transaction_source "$file" || ready_claim_rc=$?
                if [ "$ready_claim_rc" -eq 1 ]; then
                    log "ERROR archive reason=source_claim_unresolved" \
                        "file=$file path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
                if final_available "$transcript_dest" \
                        "$TRANSACTION_TRANSCRIPT_HASH" \
                        && final_available "$dest" "$TRANSACTION_SOURCE_HASH" \
                        && ensure_transaction_final "$transcript_stage" \
                            "$transcript_dest" "$TRANSACTION_TRANSCRIPT_HASH" \
                        && ensure_org_queue_final "$transcript_stage" \
                            "$transcript_dest" "$org_transcript_dest" \
                            "$org_receipt" "$TRANSACTION_TRANSCRIPT_HASH" \
                        && ensure_transaction_final "$audio_stage" "$dest" \
                            "$TRANSACTION_SOURCE_HASH"; then
                    source_rc=0
                    complete_transaction_source "$file" || source_rc=$?
                    if [ "$source_rc" -eq 2 ]; then
                        if ! remove_transaction "$transaction"; then
                            log "ERROR archive reason=transaction_cleanup_failed" \
                                "path=$transaction"
                        fi
                        log "ERROR archive reason=source_replaced file=$file"
                    elif [ "$source_rc" -eq 0 ]; then
                        remove_transaction "$transaction" ||
                            log "WARN archive reason=transaction_cleanup_deferred" \
                                "path=$transaction"
                        rm -f -- "$fail_file"
                        log "recovered archive transaction file=$file"
                        log "archived: $base -> $archive_dir"
                        transcribed=$((transcribed + 1))
                        continue
                    else
                        log "ERROR archive reason=source_claim_unresolved" \
                            "file=$file path=$transaction"
                    fi
                else
                    log "ERROR archive reason=recovery_collision file=$file" \
                        "dest=$dest transcript_dest=$transcript_dest" \
                        "org_transcript_dest=$org_transcript_dest"
                fi
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi

            # A preparing transaction may already own the source in its claim
            # directory after a crash between the atomic pre-publication claim
            # and the ready manifest. Otherwise absence is an explicit
            # cancellation (for example, a mistaken recording was deleted).
            if [ ! -e "$file" ] && [ ! -L "$file" ]; then
                claim="$recordings_dir/$TRANSACTION_CLAIM_DIR_NAME/source"
                if source_matches_transaction "$claim"; then
                    : # Resume from the durable claimed source and audio stage.
                else
                    if [ -e "$claim" ] || [ -L "$claim" ]; then
                        log "ERROR archive reason=source_claim_unresolved" \
                            "file=$file path=$transaction"
                        archive_failed=$((archive_failed + 1))
                        exit_code=1
                    elif remove_transaction "$transaction"; then
                        rm -f -- "$fail_file"
                        log "canceled deleted recording file=$file"
                    else
                        log "ERROR archive reason=transaction_cleanup_failed" \
                            "path=$transaction"
                        archive_failed=$((archive_failed + 1))
                        exit_code=1
                    fi
                    continue
                fi
            fi

            if ! final_matches_hash "$audio_stage" \
                    "$TRANSACTION_SOURCE_HASH"; then
                if source_matches_transaction "$file" \
                        && remove_transaction "$transaction"; then
                    log "discarded incomplete archive transaction file=$base"
                    transaction=''
                else
                    log "ERROR archive reason=incomplete_stage_source_changed" \
                        "file=$file path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
            fi
        fi

        if [ -z "$transaction" ]; then
            if [ ! -f "$file" ] || [ -L "$file" ]; then
                log "ERROR archive reason=source_missing file=$file"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
        fi

        # The Just Press Record iCloud container accepts audio documents only;
        # CloudDocs moves .txt files placed there to iCloud Trash. Keep the
        # durable transcript beside its archived audio and publish a second
        # hard link into a local Org-import queue. Refuse collisions before the
        # expensive transcription call so no final can be overwritten.
        if [ -e "$dest" ] || [ -L "$dest" ] \
                || [ -e "$transcript_dest" ] || [ -L "$transcript_dest" ] \
                || [ -e "$org_transcript_dest" ] \
                || [ -L "$org_transcript_dest" ]; then
            log "ERROR archive reason=target_exists file=$file" \
                "dest=$dest transcript_dest=$transcript_dest" \
                "org_transcript_dest=$org_transcript_dest"
            archive_failed=$((archive_failed + 1))
            exit_code=1
            continue
        fi
        if [ -z "$transaction" ]; then
            if ! transaction=$(create_transaction "$file" "$base"); then
                log "ERROR archive reason=transaction_create_failed file=$file"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
            if ! load_transaction "$transaction"; then
                log "ERROR archive reason=transaction_manifest_failed" \
                    "path=$transaction"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
            audio_stage="$transaction/audio"
            transcript_stage="$transaction/transcript"
            if ! cp -p "$file" "$audio_stage" >>"$log_file" 2>&1 \
                    || ! final_matches_hash "$audio_stage" \
                        "$TRANSACTION_SOURCE_HASH"; then
                if source_matches_transaction "$file"; then
                    remove_transaction "$transaction" || true
                fi
                log "ERROR archive reason=audio_stage_failed file=$file"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
        else
            # Reload after discovery and recovery checks so retry accounting is
            # bound to the exact durable stage selected for this run.
            if ! load_transaction "$transaction" \
                    || [ "$TRANSACTION_STATE" != preparing ] \
                    || ! final_matches_hash "$audio_stage" \
                        "$TRANSACTION_SOURCE_HASH"; then
                log "ERROR archive reason=preparing_transaction_changed" \
                    "path=$transaction"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi
        fi

        work_source_hash=$TRANSACTION_SOURCE_HASH
        attempts=0
        if [ -f "$fail_file" ]; then
            stored_fingerprint=''
            stored_source_hash=''
            stored_attempts=''
            stored_extra=''
            IFS=' ' read -r stored_fingerprint stored_source_hash \
                stored_attempts stored_extra <"$fail_file" || true
            if [ -z "$stored_extra" ] \
                    && [ "$stored_fingerprint" = "$route_fingerprint" ] \
                    && [ "$stored_source_hash" = "$work_source_hash" ]; then
                case "$stored_attempts" in
                    ''|*[!0-9]*|0[0-9]*) attempts=0 ;;
                    ?) attempts=$stored_attempts ;;
                    *) attempts=$max_attempts ;;
                esac
            fi
        fi
        if [ "$attempts" -ge "$max_attempts" ]; then
            log "transcribe gave_up attempts=$attempts request_id=$request_id" \
                "route_sha256=$route_fingerprint" \
                "source_sha256=$work_source_hash file=$file"
            transcribe_gave_up=$((transcribe_gave_up + 1))
            continue
        fi

        # A preparing transaction may contain a partial transcript from a
        # killed attempt. Only its hash-verified audio stage is durable.
        rm -f -- "$transcript_stage" "$transaction/manifest.next"
        if ! final_matches_hash "$audio_stage" "$work_source_hash"; then
            log "ERROR archive reason=audio_stage_changed_before_asr" \
                "path=$transaction"
            archive_failed=$((archive_failed + 1))
            exit_code=1
            continue
        fi
        log "transcribe begin request_id=$request_id file=$file"
        if transcribe -p "@$prompt_file" \
                      --llm-config "$route_snapshot" \
                      --request-id "$request_id" \
                      -o "$transcript_source" "$audio_stage" \
                      >>"$log_file" 2>&1; then
            log "transcribe ok request_id=$request_id file=$file"

            # Persist the transcript hash before touching the public source.
            # A claiming manifest makes every possible rename outcome
            # recoverable without repeating or losing the completed ASR.
            if ! final_matches_hash "$audio_stage" "$work_source_hash" \
                    || ! cp -p "$transcript_source" "$transcript_stage" \
                        >>"$log_file" 2>&1 \
                    || ! mark_transaction_claiming "$transaction"; then
                rc=$?
                if load_transaction "$transaction" 2>/dev/null \
                        && [ "$TRANSACTION_STATE" = preparing ] \
                        && final_matches_hash "$audio_stage" \
                            "$TRANSACTION_SOURCE_HASH"; then
                    rm -f -- "$transcript_stage" "$transaction/manifest.next"
                fi
                log "ERROR archive reason=claiming_transition_failed rc=$rc" \
                    "file=$file"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi

            # Atomically claim the source before making the manifest ready or
            # publishing either final. Mismatched claims stay put until ready,
            # so a crash cannot make the original stage look canceled.
            source_claim_rc=0
            claim_transaction_source "$file" 1 || source_claim_rc=$?
            case "$source_claim_rc" in
                0|2) ;;
                3)
                    rm -f -- "$transcript_source" "$fail_file"
                    if remove_transaction "$transaction"; then
                        log "canceled deleted recording file=$file"
                    else
                        log "ERROR archive reason=transaction_cleanup_failed" \
                            "path=$transaction"
                        archive_failed=$((archive_failed + 1))
                        exit_code=1
                    fi
                    continue
                    ;;
                *)
                    log "ERROR archive reason=source_claim_unresolved" \
                        "file=$file path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                    ;;
            esac

            if ! mark_transaction_ready "$transaction"; then
                log "ERROR archive reason=ready_transition_failed" \
                    "path=$transaction"
                archive_failed=$((archive_failed + 1))
                exit_code=1
                continue
            fi

            # Both hashes and the source disposition are now durable. Publish
            # each final with no-replace links, then release the source claim.
            if final_available "$transcript_dest" \
                        "$TRANSACTION_TRANSCRIPT_HASH" \
                    && final_available "$dest" "$TRANSACTION_SOURCE_HASH" \
                    && ensure_transaction_final "$transcript_stage" \
                        "$transcript_dest" "$TRANSACTION_TRANSCRIPT_HASH" \
                    && ensure_org_queue_final "$transcript_stage" \
                        "$transcript_dest" "$org_transcript_dest" \
                        "$org_receipt" "$TRANSACTION_TRANSCRIPT_HASH" \
                    && ensure_transaction_final "$audio_stage" "$dest" \
                        "$TRANSACTION_SOURCE_HASH"; then
                source_rc=0
                complete_transaction_source "$file" || source_rc=$?
                if [ "$source_rc" -eq 2 ]; then
                    if ! remove_transaction "$transaction"; then
                        log "ERROR archive reason=transaction_cleanup_failed" \
                            "path=$transaction"
                    fi
                    rm -f -- "$fail_file"
                    log "ERROR archive reason=source_replaced file=$file"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
                if [ "$source_rc" -ne 0 ]; then
                    log "ERROR archive reason=source_claim_unresolved" \
                        "file=$file path=$transaction"
                    archive_failed=$((archive_failed + 1))
                    exit_code=1
                    continue
                fi
                remove_transaction "$transaction" ||
                    log "WARN archive reason=transaction_cleanup_deferred" \
                        "path=$transaction"
                rm -f -- "$fail_file"
                log "archived: $base -> $archive_dir"
                transcribed=$((transcribed + 1))
            else
                rc=$?
                reason=publish_failed
                # The ready transaction may already own one final and always
                # owns both verified stages. Preserve it for lossless recovery.
                log "ERROR archive reason=$reason rc=$rc file=$file" \
                    "org_transcript_dest=$org_transcript_dest"
                archive_failed=$((archive_failed + 1))
                exit_code=1
            fi
        else
            rc=$?
            log "ERROR transcribe rc=$rc request_id=$request_id file=$file"
            rm -f "$transcript_source"
            printf '%s %s %s\n' "$route_fingerprint" "$work_source_hash" \
                "$((attempts + 1))" >"$fail_file"
            transcribe_failed=$((transcribe_failed + 1))
            exit_code=1
        fi
    done
fi
